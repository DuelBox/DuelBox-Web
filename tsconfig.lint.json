{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "jsx": "preserve",
    "allowJs": true,
    "paths": {
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx", "*.ts", "*.js", "e2e/**/*.ts"]
}
