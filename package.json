{
  "name": "duelbox",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @duelbox/web dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm validate:manifests && pnpm share:images && pnpm --filter @duelbox/web build && pnpm emit:host-config && pnpm emit:service-worker && pnpm check:headers && pnpm check:zero-cost && pnpm check:secrets && pnpm check:assets && pnpm check:names && pnpm check:share-images && pnpm check:structured-data && pnpm check:canonicals && pnpm check:images && pnpm check:renderer-flag && pnpm size",
    "typecheck": "tsc --build && tsc --noEmit -p tsconfig.lint.json && pnpm --filter @duelbox/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:allocation": "DUELBOX_ALLOCATION=1 vitest run packages/engine/src/allocation.test.ts --maxWorkers=1",
    "test:watch": "vitest",
    "test:coverage": "DUELBOX_COVERAGE=1 vitest run --coverage",
    "clean": "tsc --build --clean && rm -rf packages/*/dist apps/*/.next",
    "create-game": "node scripts/create-game.mjs",
    "catalogue": "python3 scripts/generate_catalog.py",
    "fuzz:soak": "DUELBOX_FUZZ_MINUTES=60 vitest run apps/web/src/data/input-fuzz.test.ts",
    "balance:sweep": "vitest run apps/web/src/data/balance-aggregate.test.ts",
    "balance:audit": "DUELBOX_BALANCE_SEEDS=250 pnpm balance:sweep",
    "e2e": "playwright test",
    "e2e:all": "DUELBOX_ALL_ENGINES=1 playwright test",
    "validate:manifests": "node scripts/validate-manifests.mjs",
    "check:zero-cost": "node scripts/check-zero-cost.mjs",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "size": "node scripts/check-size.mjs",
    "share:images": "node scripts/generate-share-images.mjs",
    "emit:icons": "node scripts/emit-icon-sprite.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:structured-data": "node scripts/check-structured-data.mjs",
    "check:canonicals": "node scripts/check-canonicals.mjs",
    "check:images": "node scripts/check-images.mjs",
    "check:renderer-flag": "node scripts/check-renderer-flag.mjs",
    "check:share-images": "node scripts/check-share-images.mjs",
    "check:assets": "node scripts/check-asset-licenses.mjs",
    "check:names": "node scripts/check-game-names.mjs",
    "check:source-secrets": "node scripts/check-source-secrets.mjs",
    "emit:host-config": "node scripts/emit-host-config.mjs",
    "emit:service-worker": "node scripts/emit-service-worker.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "emit:attribution": "node scripts/emit-attribution.mjs",
    "check:attribution": "node scripts/emit-attribution.mjs --check",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "^2.27.11",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "4.13.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@4": ">=4.3.2 <5",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.4",
      "vite": ">=6.4.3"
    }
  }
}
