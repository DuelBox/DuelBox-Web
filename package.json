{
  "name": "duelbox",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @duelbox/web dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm validate:manifests && pnpm --filter @duelbox/web build && pnpm check:zero-cost && pnpm check:secrets && pnpm check:assets && pnpm size",
    "typecheck": "tsc --build && tsc --noEmit -p tsconfig.lint.json && pnpm --filter @duelbox/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "tsc --build --clean && rm -rf packages/*/dist apps/*/.next",
    "create-game": "node scripts/create-game.mjs",
    "catalogue": "python3 scripts/generate_catalog.py",
    "e2e": "playwright test",
    "e2e:all": "DUELBOX_ALL_ENGINES=1 playwright test",
    "validate:manifests": "node scripts/validate-manifests.mjs",
    "check:zero-cost": "node scripts/check-zero-cost.mjs",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "size": "node scripts/check-size.mjs",
    "check:assets": "node scripts/check-asset-licenses.mjs",
    "check:source-secrets": "node scripts/check-source-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.11.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0",
      "vite": ">=6.4.3"
    }
  }
}
